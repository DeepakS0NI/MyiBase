@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
   
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"  href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyiBase.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.xyz">
    <link rel="preconnect" href="https://fonts.gstatic.xyz" crossorigin>
    <link href="https://fonts.googleapis.xyz/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">  *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark site-nav">
            <div class="container">
                <a class="navbar-brand brand" href="#home" aria-label="MyiBase home">
                    <span class="brand-mark"><i></i><i></i><i></i><i></i></span><span>MyiBase</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link active" href="/home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home#features">Features</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home#pricing">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home#how-it-works">How it works</a></li>
                        <li class="nav-item"><a class="nav-link" href="/home#faq">FAQ</a></li>
                    </ul>
                    <div class="nav-actions d-flex align-items-center gap-2">
                        <a class="btn btn-login" href="/home/login">Log in</a>
                        <a class="btn btn-gradient" href="/home/signup">Get started <i class="bi bi-arrow-up-right ms-1"></i></a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
   
            @RenderBody()

    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4 footer-main">
                <div class="col-lg-4"><a class="brand footer-brand" href="/home"><span class="brand-mark"><i></i><i></i><i></i><i></i></span><span>MyiBase</span></a><p class="footer-tagline">Your subdomain. Your identity.</p><div class="social-links"><a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a><a href="#" aria-label="GitHub"><i class="bi bi-github"></i></a><a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a></div></div>
                <div class="col-6 col-lg-2"><h4>Explore</h4><a href="/home#features">Features</a><a href="#pricing">Pricing</a><a href="#how-it-works">How it works</a><a href="#faq">FAQ</a></div>
                <div class="col-6 col-lg-2"><h4>Support</h4><a href="mailto:support@myibase.xyz">Contact us</a><a href="~/policy/RefundCancellationPolicy.html">Refund Policy</a><a href="~/policy/TermsAndConditions.html">Terms of service</a><a href="~/policy/Privacypolicy.html">Privacy policy</a></div>
                <div class="col-lg-4"><h4>Stay in the loop</h4><p>Product updates and useful tips, occasionally.</p><form class="newsletter" id="newsletterForm"><label class="visually-hidden" for="newsletterEmail">Email address</label><input id="newsletterEmail" type="email" placeholder="Your email address" required><button type="submit" aria-label="Subscribe"><i class="bi bi-arrow-right"></i></button></form><div id="newsletterMessage" class="newsletter-message" role="status"></div></div>
            </div>
            <div class="footer-bottom"><span>© <span id="year"></span> MyiBase. All rights reserved.</span><span>Made for creators, developers &amp; dreamers.</span></div>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="siteToast" class="toast text-bg-dark border border-secondary" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex"><div class="toast-body" id="toastText">Thanks!</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
