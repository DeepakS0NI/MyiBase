
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard | MyiBase</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <link rel="stylesheet"
          href="/css/dashboard.css"
          asp-append-version="true">
</head>

<body>

    <!-- ============================================ -->
    <!-- SIDEBAR -->
    <!-- ============================================ -->

    <aside class="sidebar" id="sidebar">

        <a href="index.html" class="brand">
            <span class="brand-logo">☁</span>
            <span>MyiBase</span>
        </a>


        <!-- USER -->
        <div class="user-mini">

            <div class="avatar" id="sidebarAvatar">
                User
            </div>

            <div>

                <strong id="sidebarName">
                    Loading...
                </strong>

                <span id="sidebarEmail">
                    Loading...
                </span>

            </div>

        </div>


        <!-- NAVIGATION -->
        <nav class="side-nav">

            <a href="#dashboard"
               class="nav-item active"
               data-page="dashboard">

                <span>⌂</span>
                Dashboard

            </a>


            <a href="#domains"
               class="nav-item"
               data-page="domains">

                <span>◈</span>
                My Subdomains

            </a>


            <a href="#dns"
               class="nav-item"
               data-page="dns">

                <span>⌁</span>
                DNS Settings

            </a>


            @* <a href="#billing"
               class="nav-item"
               data-page="billing">

                <span>▣</span>
                Billing

            </a> *@



        </nav>


        <!-- SIDEBAR BOTTOM -->
        <div class="sidebar-bottom">

            <a href="#" class="nav-item">

                <span>?</span>
                Help & Support

            </a>


            <button class="logout"
                    id="logoutBtn">

                <span>↪</span>
                Logout

            </button>

        </div>

    </aside>


    <!-- ============================================ -->
    <!-- MOBILE OVERLAY -->
    <!-- ============================================ -->

    <div class="overlay"
         id="overlay">
    </div>


    <!-- ============================================ -->
    <!-- MAIN -->
    <!-- ============================================ -->

    <main class="main">


        <!-- ============================================ -->
        <!-- TOPBAR -->
        <!-- ============================================ -->

        <header class="topbar">

            <button class="menu-btn"
                    id="menuBtn">

                ☰

            </button>


            <div>

                <p class="top-label">
                    MYIBASE ACCOUNT
                </p>

                <h1 id="pageTitle">
                    Dashboard
                </h1>

            </div>


            <div class="top-actions">

                <button class="icon-btn"
                        title="Notifications"
                        id="notificationBtn">

                    ♢

                    <i></i>

                </button>


                <!-- TOP USER -->
                <div class="top-user">

                    <div class="avatar small"
                         id="topAvatar">

                        DS

                    </div>


                    <div class="top-user-text">

                        <strong id="topUserName">
                            Loading...
                        </strong>

                        <span>
                            Free Plan
                        </span>

                    </div>

                </div>

            </div>

        </header>


        <!-- ============================================ -->
        <!-- DASHBOARD PAGE -->
        <!-- ============================================ -->

        <section class="page active-page"
                 id="dashboardPage">


            <!-- WELCOME -->
            <div class="welcome">

                <div>

                    <p class="eyebrow">
                        WELCOME BACK
                    </p>


                    <h2>
                        Hello,
                        <span id="welcomeName">
                            Loading...
                        </span>
                        👋
                    </h2>


                    <p>
                        Manage your MyiBase subdomains
                        and connect them to your websites.
                    </p>

                </div>


                <a href="https://localhost:7084/home"
                   class="primary-btn">

                    + Get New Subdomain

                </a>

            </div>


            <!-- ============================================ -->
            <!-- STATS -->
            <!-- ============================================ -->

            <div class="stats-grid">


                <div class="stat-card">

                    <div class="stat-icon blue">
                        ◈
                    </div>

                    <div>

                        <span>
                            Active Subdomains
                        </span>

                        <strong>
                            @ViewBag.UserData.User_Subd_Count
                        </strong>

                    </div>

                    <small class="up">
                        @* +1 this month *@
                    </small>

                </div>


                <div class="stat-card">

                    <div class="stat-icon purple">
                        ⌁
                    </div>

                    <div>

                        <span>
                            DNS Connected
                        </span>

                        <strong>
                            @{int dns =0;
                                foreach (var subdomain in ViewBag.UserData.subdomains)
                            {
                                if(subdomain.target == null)
                                {
                                     dns = +1;
                                }
                            }
                            }
                            @dns
                        </strong>

                    </div>

                    <small class="up">
                        connected
                    </small>

                </div>


                <div class="stat-card">

                    <div class="stat-icon green">
                        ✓
                    </div>

                    <div>

                        <span>
                            Account Status
                        </span>

                        <strong class="status-text">
                            Active
                        </strong>

                    </div>

                    <small class="up">
                        Verified account
                    </small>

                </div>


                <div class="stat-card">

                    <div class="stat-icon orange">
                        ₹
                    </div>

                    <div>

                        <span>
                            Total Spent
                        </span>

                        <strong>
                            @ViewBag.UserData.User_total_spend
                        </strong>

                    </div>

                    <small>
                        Lifetime
                    </small>

                </div>

            </div>


            <!-- ============================================ -->
            <!-- CONTENT GRID -->
            <!-- ============================================ -->

            <div class="content-grid">


                <!-- SUBDOMAINS -->
                <div class="panel large-panel">

                    <div class="panel-head">

                        <div>

                            <h3>
                                Your Subdomains
                            </h3>

                            <p>
                                Manage domains registered
                                with your account.
                            </p>

                        </div>


                        <a href="#domains"
                           class="view-link">

                            View all →

                        </a>

                    </div>


                    <div class="domain-list">


                        <!-- DOMAIN 1 -->
                        
                        <div id="domain-list"></div>

                        @foreach (var subdomain in ViewBag.UserData.subdomains)
                        {
                            <div class="domain-row">

                                <div class="domain-symbol purple-symbol">
                                    @subdomain.subd.Substring(0, 1).ToUpper()
                                </div>

                                <div class="domain-info">

                                    <strong>
                                        @subdomain.subd
                                    </strong>

                                    <span>
                                        @($"{subdomain.subd}.myibase.xyz")
                                    </span>

                                </div>

                                @if(subdomain.target == null)
                                {
                                    <span class="connected" style="background: #ffedb5;">
                                    <i></i>
                                    Disconnected                                 
                                    </span>
                                }
                                else
                                {
                                    <span class="connected">
                                        <i></i>
                                        Connected
                                    </span>
                                }
                                <div class="domain-actions">

                                    <button title="Copy domain"
                                            class="copy-btn"
                                            data-domain="@($"{subdomain.subd}.myibase.xyz")">

                                        ⧉

                                    </button>

                                    <button title="Manage"
                                            class="manage-btn outline-btn">

                                        Manage

                                    </button>

                                </div>

                            </div>
                        }

                    </div>

                </div>


                <!-- ============================================ -->
                <!-- QUICK ACTIONS -->
                <!-- ============================================ -->

                <div class="panel quick-panel">

                    <div class="panel-head">

                        <div>

                            <h3>
                                Quick Actions
                            </h3>

                            <p>
                                Common account actions.
                            </p>

                        </div>

                    </div>


                    <div class="quick-actions">


                        <a href="https://localhost:7084/home"
                           class="quick-action">

                            <span class="qa-icon blue">
                                +
                            </span>

                            <div>

                                <strong>
                                    Buy Subdomain
                                </strong>

                                <small>
                                    Find your next name
                                </small>

                            </div>

                            <b>
                                →
                            </b>

                        </a>


                        <a href="#dns"
                           class="quick-action">

                            <span class="qa-icon purple">
                                ⌁
                            </span>

                            <div>

                                <strong>
                                    DNS Settings
                                </strong>

                                <small>
                                    Connect your website
                                </small>

                            </div>

                            <b>
                                →
                            </b>

                        </a>


                      

                    </div>

                </div>

            </div>


            <!-- ============================================ -->
            <!-- DNS GUIDE -->
            <!-- ============================================ -->

            <div class="panel guide-panel">

                <div class="guide-icon">
                    ⌁
                </div>


                <div class="guide-content">

                    <span class="guide-label">
                        GET STARTED
                    </span>


                    <h3>
                        Connect your subdomain
                        to your website
                    </h3>


                    <p>

                        Your website can be hosted anywhere.
                        Just add the DNS record provided by
                        your hosting provider and point your
                        MyiBase subdomain to it.

                    </p>


                    <a href="#dns"
                       class="secondary-btn">

                        View DNS Instructions →

                    </a>

                </div>


                <div class="dns-preview">

                    <div>

                        <span>
                            Type
                        </span>

                        <strong>
                            CNAME
                        </strong>

                    </div>


                    <div>

                        <span>
                            Name
                        </span>

                        <strong>
                            www
                        </strong>

                    </div>


                    <div>

                        <span>
                            Target
                        </span>

                        <strong>
                            your-host.com
                        </strong>

                    </div>

                </div>

            </div>

        </section>


        <!-- ============================================ -->
        <!-- DOMAINS PAGE -->
        <!-- ============================================ -->

        <section class="page"
                 id="domainsPage">

            <div class="section-title">

                <div>

                    <p class="eyebrow">
                        DOMAIN MANAGEMENT
                    </p>

                    <h2>
                        My Subdomains
                    </h2>

                    <p>
                        All subdomains registered
                        under your MyiBase account.
                    </p>

                </div>


                <a href="https://localhost:7084/home"
                   class="primary-btn">

                    + Buy Subdomain

                </a>

            </div>


            <div class="panel table-panel">

                <div class="table-head">

                    <span>
                        SUBDOMAIN
                    </span>

                    <span>
                        STATUS
                    </span>

                    <span>
                        DNS
                    </span>

                    <span>
                        CREATED
                    </span>

                    <span>
                        ACTION
                    </span>

                </div>

                   @foreach (var subdomain in ViewBag.UserData.subdomains)
                {
                    <div class="table-row">

                        <div class="table-domain">

                            <div class="domain-symbol">
                                @subdomain.subd.Substring(0, 1).ToUpper()
                            </div>

                            <div>

                                <strong>
                                    @subdomain.subd
                                </strong>

                                <small>
                                    @($"{subdomain.subd}.myibase.xyz")
                                </small>

                            </div>

                        </div>

                        <span class="badge active">
                            Active
                        </span>


                        @if (subdomain.target == null)
                        {
                            <span class="badge connected-badge" style="background: #ffedb5;">
                                
                                Disconnected
                            </span>
                        }
                        else
                        {
                            <span class="badge connected-badge">
                               
                                Connected
                            </span>
                        }

                        <span>
                            @subdomain.createdat
                        </span>

                        <button class="outline-btn">
                            Manage
                        </button>

                    </div>

                }

          
            </div>


        </section>


        <!-- ============================================ -->
        <!-- DNS PAGE -->
        <!-- ============================================ -->

        <section class="page"
                 id="dnsPage">

            <div class="section-title">

                <div>

                    <p class="eyebrow">
                        DNS MANAGEMENT
                    </p>

                    <h2>
                        DNS Settings
                    </h2>

                    <p>
                        Connect your MyiBase subdomain
                        to a website hosted anywhere.
                    </p>

                </div>

            </div>


            <div class="panel dns-panel">

               @foreach (var subdomain in ViewBag.UserData.subdomains)
                {

                <div class="dns-domain-head">

                    <div class="domain-symbol">
                            @subdomain.subd.Substring(0, 1).ToUpper()
                    </div>

                    <div>

                        <strong>
                                @($"{subdomain.subd}.myibase.xyz")
                        </strong>

                        @if (subdomain.target == null)
                        {       
                        <span>
                            DNS is ready to connect
                        </span>
                        }
                        else
                        {
                        <span>
                            DNS is active
                        </span>
                        }

                    </div>

                   
                    @if (subdomain.target == null)
                    {
                            <span class="connected" style="background: #ffedb5;">
                            <i></i>
                            Disconnected
                        </span>
                    }
                    else
                    {
                        <span class="connected">
                            <i></i>
                            Connected
                        </span>
                    }
                </div>


                <div class="dns-table">

                    <div class="dns-table-head">

                        <span>
                            TYPE
                        </span>

                        <span>
                            NAME
                        </span>

                        <span>
                            VALUE
                        </span>

                        <span>
                            TTL
                        </span>

                        <span>
                           
                        </span>

                    </div>


                           
                      @if (subdomain.target == null)
                        {
                            
                            <div class="dns-row">

                                <strong>
                                    CNAME
                                </strong>

                                <span>
                                    @subdomain.subd
                                </span>

                                <input id="target-value" data-subd="@subdomain.subd" type="text" name="name" value="" placeholder="enter your target url" width="100" />

                                <span>
                                    Auto
                                </span>

                                <span>
                                <button class="add-record "  >

                                    Save_Record

                                </button>
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="dns-row">

                                <strong>
                                    CNAME
                                </strong>

                                <span>
                                    @subdomain.subd
                                </span>

                                <input id="target-value" data-subd="@subdomain.subd" type="text" name="name" value="@subdomain.target" placeholder="enter your target url" width="100" readonly />

                                <span>
                                    Auto
                                </span>

                                <span>
                                <button class="delete-record" data-subd="@subdomain.subd" >

                                    delete_Record

                                </button>
                                </span>

                            </div>
                        }
                                                      
                </div>

                }
            </div>

        </section>


        <!-- ============================================ -->
        <!-- BILLING PAGE -->
        <!-- ============================================ -->

        @* <section class="page"
                 id="billingPage">

            <div class="section-title">

                <div>

                    <p class="eyebrow">
                        ACCOUNT BILLING
                    </p>

                    <h2>
                        Billing
                    </h2>

                    <p>
                        Manage your purchases
                        and payment history.
                    </p>

                </div>

            </div>


            <div class="billing-grid">


                <div class="panel plan-card">

                    <span class="plan-label">
                        CURRENT PLAN
                    </span>

                    <h3>
                        Free Account
                    </h3>

                    <p>
                        Manage your MyiBase subdomains.
                    </p>

                    <strong>
                        ₹0
                        <small>
                            / month
                        </small>
                    </strong>

                    <button class="primary-btn">
                        View Plans
                    </button>

                </div>


                <div class="panel payment-card">

                    <h3>
                        Recent Payment
                    </h3>


                    <div class="payment-row">

                        <span>
                            Subdomain purchase
                        </span>

                        <strong>
                            ₹99
                        </strong>

                    </div>


                    <div class="payment-row">

                        <span>
                            29 Sep 2026
                        </span>

                        <span class="paid">
                            Paid
                        </span>

                    </div>

                </div>

            </div>

        </section> *@

    </main>


    <!-- ============================================ -->
    <!-- TOAST -->
    <!-- ============================================ -->

    <div class="toast"
         id="toast">

        <span>
            ✓
        </span>

        <p id="toastText">
            Copied successfully.
        </p>

    </div>


    <!-- ============================================ -->
    <!-- DASHBOARD JS -->
    <!-- ============================================ -->

    <script src="/js/dashboard.js"
            asp-append-version="true">
    </script>
</body>
</html>
