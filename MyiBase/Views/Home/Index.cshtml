@{
    ViewData["Title"] = "Home Page";
}

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#080d1d">
    <meta name="description" content="Get your own MyiBase subdomain and connect it to the website you already host.">
    <title>MyiBase — Your Subdomain. Your Identity.</title>
</head>

<main>
    <section class="hero-section" id="home">
        <div class="hero-glow glow-one"></div><div class="hero-glow glow-two"></div>
        <div class="container hero-container">
            <div class="row align-items-center gy-5">
                <div class="col-lg-7 hero-copy">
                    <div class="eyebrow"><span class="sparkle">✦</span> Your name. Your identity. Online.</div>
                    <h1>Premium Subdomains<br>for Your <span class="gradient-text">Digital Identity</span></h1>
                    <p class="hero-lead">Get your unique subdomain on MyiBase and connect it to your website. Simple, affordable, and built for creators, businesses, and professionals.</p>
                    <form class="domain-search" id="domainForm">
                        <label class="visually-hidden" for="domainName">Your desired subdomain</label>
                        <input id="domainName" type="text" placeholder="Enter your desired name" autocomplete="off" maxlength="40" required>
                        <span class="domain-suffix">.myibase.xyz <i class="bi bi-chevron-down"></i></span>
                        <button class="btn btn-gradient search-btn" type="submit"><i class="bi bi-search me-2"></i>Search</button>
                    </form>
                    <div class="search-message" id="searchMessage" role="status" aria-live="polite"></div>
                    <div class="hero-perks">
                        <span><i class="bi bi-check2-square"></i> Simple setup</span>
                        <span><i class="bi bi-check2-square"></i> Affordable pricing</span>
                        <span><i class="bi bi-check2-square"></i> No hosting required</span>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="hero-art" aria-label="Illustration of a website connected to a subdomain">
                        <div class="art-orbit orbit-a"></div><div class="art-orbit orbit-b"></div>
                        <div class="art-window">
                            <div class="window-top"><span></span><span></span><span></span><div class="window-dots"></div></div>
                            <div class="address-bar"><i class="bi bi-lock-fill"></i><span class="address-name">yourname</span><span>.myibase.xyz</span></div>
                            <div class="preview-content">
                                <div class="preview-nav"><b></b><span></span><span></span><span></span></div>
                                <div class="preview-main">
                                    <div class="preview-avatar"></div>
                                    <div class="preview-lines"><b></b><span></span></div>
                                    <div class="preview-heading">Your Website<br><strong>Your Rules</strong></div>
                                    <div class="preview-cta">Live Now <i class="bi bi-arrow-up-right"></i></div>
                                    <div class="preview-landscape"><span></span><i></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="float-tag tag-fast"><span class="tag-icon green"><i class="bi bi-lightning-charge-fill"></i></span> Fast setup</div>
                        <div class="float-tag tag-secure"><span class="tag-icon purple"><i class="bi bi-shield-check"></i></span> Secure &amp; reliable</div>
                        <div class="float-tag tag-global"><span class="tag-icon blue"><i class="bi bi-globe2"></i></span> Global access</div>
                        <div class="art-spark spark-one">✦</div><div class="art-spark spark-two">✧</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="trust-strip">
        <div class="container">
            <div class="row g-3">
                <div class="col-6 col-lg-3"><div class="trust-item"><span class="trust-icon violet"><i class="bi bi-person-check"></i></span><div><strong>Easy to claim</strong><small>Your name, your space</small></div></div></div>
                <div class="col-6 col-lg-3"><div class="trust-item"><span class="trust-icon purple"><i class="bi bi-globe2"></i></span><div><strong>DNS control</strong><small>Connect your own host</small></div></div></div>
                <div class="col-6 col-lg-3"><div class="trust-item"><span class="trust-icon green"><i class="bi bi-shield-check"></i></span><div><strong>Built for you</strong><small>Simple domain management</small></div></div></div>
                <div class="col-6 col-lg-3"><div class="trust-item"><span class="trust-icon yellow"><i class="bi bi-lightning-charge"></i></span><div><strong>Quick setup</strong><small>Get online with ease</small></div></div></div>
            </div>
        </div>
    </section>

    <section class="features-section section-pad" id="features">
        <div class="container">
            <div class="section-heading text-center">
                <span class="section-pill">WHY CHOOSE MYIBASE</span>
                <h2>A smarter way to <span class="gradient-text">get online</span></h2>
                <p>Everything you need to give your project a memorable address — without managing a domain from scratch.</p>
            </div>
            <div class="row g-4 feature-grid">
                <div class="col-md-6 col-lg-4"><article class="feature-card"><div class="feature-icon icon-violet"><i class="bi bi-lightning-charge-fill"></i></div><h3>Easy setup</h3><p>Claim a subdomain with a simple, straightforward process.</p></article></div>
                <div class="col-md-6 col-lg-4"><article class="feature-card"><div class="feature-icon icon-green"><i class="bi bi-shield-check"></i></div><h3>Full DNS control</h3><p>Point your subdomain to the hosting provider you already use.</p></article></div>
                <div class="col-md-6 col-lg-4"><article class="feature-card"><div class="feature-icon icon-blue"><i class="bi bi-globe2"></i></div><h3>Made for the web</h3><p>Give your portfolio, project, or business its own online address.</p></article></div>
                <div class="col-md-6 col-lg-4"><article class="feature-card"><div class="feature-icon icon-pink"><i class="bi bi-sliders"></i></div><h3>Simple management</h3><p>Manage your subdomain and DNS settings from one dashboard.</p></article></div>
                <div class="col-md-6 col-lg-4"><article class="feature-card"><div class="feature-icon icon-orange"><i class="bi bi-wallet2"></i></div><h3>Clear pricing</h3><p>Know what you pay for your subdomain, with no hosting bundle.</p></article></div>
                <div class="col-md-6 col-lg-4"><article class="feature-card"><div class="feature-icon icon-violet"><i class="bi bi-headset"></i></div><h3>Helpful support</h3><p>Find guidance for connecting your subdomain to your website.</p></article></div>
            </div>
        </div>
    </section>

    <section class="how-section section-pad" id="how-it-works">
        <div class="container">
            <div class="section-heading text-center">
                <span class="section-pill">HOW IT WORKS</span>
                <h2>Three steps. <span class="gradient-text">Your own address.</span></h2>
                <p>Keep your existing hosting. MyiBase helps you get the name and connect the DNS.</p>
            </div>
            <div class="row g-4 steps-row">
                <div class="col-md-4"><div class="step-card"><div class="step-number">01</div><div class="step-icon"><i class="bi bi-search"></i></div><h3>Find your name</h3><p>Search for the subdomain you want and check whether it is available.</p></div></div>
                <div class="col-md-4"><div class="step-card"><div class="step-number">02</div><div class="step-icon"><i class="bi bi-bag-check"></i></div><h3>Claim your subdomain</h3><p>Choose your plan and complete the checkout to claim your name.</p></div></div>
                <div class="col-md-4"><div class="step-card"><div class="step-number">03</div><div class="step-icon"><i class="bi bi-link-45deg"></i></div><h3>Connect your website</h3><p>Add your hosting details and point the subdomain to your existing website.</p></div></div>
            </div>
            <div class="hosting-note"><i class="bi bi-info-circle"></i><span><strong>Already have hosting?</strong> Perfect. MyiBase provides the subdomain; your website stays with your hosting provider.</span></div>
        </div>
    </section>

    <section class="pricing-section section-pad" id="pricing">
        <div class="container position-relative">
            <div class="section-heading text-center">
                <span class="section-pill">SIMPLE PRICING</span>
                <h2>A plan for your <span class="gradient-text">next idea</span></h2>
                <p>Pick the subdomain plan that fits your needs. Hosting is not included.</p>
            </div>
            <div class="row g-4 justify-content-center pricing-row">
                <div class="col-md-6 col-lg-4"><article class="price-card"><div class="price-label">STARTER</div><h3>Personal</h3><p class="price-desc">For portfolios and personal projects</p><div class="price"><span class="currency">₹</span>199 <small>/ year</small></div><ul><li><i class="bi bi-check2"></i> 1 subdomain</li><li><i class="bi bi-check2"></i> DNS management</li><li><i class="bi bi-check2"></i> Connect your own hosting</li><li><i class="bi bi-check2"></i> Email support</li></ul><a href="#search" class="btn btn-outline-light w-100">Get started</a></article></div>
                <div class="col-md-6 col-lg-4"><article class="price-card featured"><div class="popular-ribbon">POPULAR</div><div class="price-label">CREATOR</div><h3>Pro</h3><p class="price-desc">For developers and creators</p><div class="price"><span class="currency">₹</span>499 <small>/ year</small></div><ul><li><i class="bi bi-check2"></i> 3 subdomains</li><li><i class="bi bi-check2"></i> DNS management</li><li><i class="bi bi-check2"></i> Connect your own hosting</li><li><i class="bi bi-check2"></i> Priority support</li></ul><a href="#search" class="btn btn-gradient w-100">Get started <i class="bi bi-arrow-up-right ms-1"></i></a></article></div>
                <div class="col-md-6 col-lg-4"><article class="price-card"><div class="price-label">BUSINESS</div><h3>Team</h3><p class="price-desc">For multiple projects and brands</p><div class="price"><span class="currency">₹</span>999 <small>/ year</small></div><ul><li><i class="bi bi-check2"></i> 10 subdomains</li><li><i class="bi bi-check2"></i> DNS management</li><li><i class="bi bi-check2"></i> Connect your own hosting</li><li><i class="bi bi-check2"></i> Priority support</li></ul><a href="#search" class="btn btn-outline-light w-100">Get started</a></article></div>
            </div>
            <p class="pricing-disclaimer text-center">Illustrative prices for the landing page. Set your actual pricing before launch.</p>
        </div>
    </section>

    <section class="faq-section section-pad" id="faq">
        <div class="container faq-container">
            <div class="section-heading text-center">
                <span class="section-pill">FAQ</span>
                <h2>Questions, <span class="gradient-text">answered.</span></h2>
            </div>
            <div class="accordion custom-accordion" id="faqAccordion">
                <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqOne" aria-expanded="true">Does MyiBase provide web hosting?</button></h3><div id="faqOne" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion"><div class="accordion-body">No. MyiBase provides subdomains only. You can connect your subdomain to a website hosted with your existing provider.</div></div></div>
                <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTwo">Can I connect my subdomain to Hostinger, Netlify, or Vercel?</button></h3><div id="faqTwo" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">You can connect it to a hosting provider that supports custom domains. Follow that provider's instructions and enter the required DNS records in your MyiBase dashboard.</div></div></div>
                <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqThree">Will HTTPS work automatically?</button></h3><div id="faqThree" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">DNS connection and HTTPS are separate. Your hosting provider usually needs to issue or enable an SSL certificate for your subdomain.</div></div></div>
                <div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqFour">Can I change my hosting provider later?</button></h3><div id="faqFour" class="accordion-collapse collapse" data-bs-parent="#faqAccordion"><div class="accordion-body">Yes. You can update your DNS record to point to your new hosting provider, subject to the supported DNS options.</div></div></div>
            </div>
        </div>
    </section>
</main>

